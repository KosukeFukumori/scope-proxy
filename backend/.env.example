# SQLiteのファイルパス(既定値のままで問題なければ設定不要)
DATABASE_URL=sqlite:///./scope_proxy.db

# セッションCookieの署名に使う秘密鍵。本番運用では必ず固定値を設定すること。
# 未設定の場合は起動のたびにランダム生成され、再起動でセッションが無効になる。
SECRET_KEY=change-me-to-a-random-secret

SESSION_COOKIE_NAME=scope_proxy_session

# ブラウザからのクロスオリジンリクエスト(SPAなど)を許可するオリジンをカンマ区切りで指定する。
# 既定は空文字列で、CORSは無効。この場合、プリフライトOPTIONSを含む全リクエストが
# 通常の認証フローに乗り、Bearerトークンなしでは401になる(安全側)。
# 例: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# セッションCookieにSecure属性を付与するか(HTTPS環境ではtrue推奨、既定値はtrue)
# ローカルでHTTP開発する場合のみfalseにすること
SESSION_COOKIE_SECURE=true

# セッションCookieの有効期限(秒)。未設定(空文字)にするとブラウザセッションCookie(ブラウザを閉じると失効)になる
SESSION_COOKIE_MAX_AGE=1209600

# ログインのレートリミット(IP・メールアドレス単位)。この試行回数を超えると429を返す
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
# 上記の試行回数をカウントする時間窓(秒)
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# アップストリームバックエンドへのリクエストに適用するタイムアウト(秒)。
# 応答に時間がかかるバックエンドを使う場合はより大きい値を設定すること。
PROXY_TIMEOUT_SECONDS=30.0
